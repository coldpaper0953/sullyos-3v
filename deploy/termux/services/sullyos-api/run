#!/data/data/com.termux/files/usr/bin/sh
# runit service · SullyOS 后端 API
#
# 安装（把 <REPO> 换成你的仓库绝对路径，例如 $HOME/sullyos）：
#   pkg install termux-services
#   mkdir -p $PREFIX/var/service/sullyos-api/log
#   cp <REPO>/deploy/termux/services/sullyos-api/run $PREFIX/var/service/sullyos-api/run
#   ln -sf $PREFIX/share/termux-services/svlogger $PREFIX/var/service/sullyos-api/log/run
#   chmod +x $PREFIX/var/service/sullyos-api/run
#   sed -i "s|__REPO__|$HOME/sullyos|" $PREFIX/var/service/sullyos-api/run
#   sv up sullyos-api
#
# 日志：sv status sullyos-api / tail -f $PREFIX/var/log/sv/sullyos-api/current

REPO=__REPO__

# runit 要求前台运行，不能自己 daemonize。
cd "$REPO/backend" || exit 1

# exec 2>&1 让 stderr 也进 svlogger
exec 2>&1

# --env-file 是必须的：应用自己不读 .env（src/config.ts 直接 parse(process.env)），
# 而 runit 启动时不会继承你 shell 里的环境。
exec node --env-file=.env dist/api.js
