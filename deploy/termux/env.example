# SullyOS 手机版环境模板（Termux）
#
# 用法：cp deploy/termux/env.example backend/.env，然后填下面标 <必填> 的三处。
# 应用本身不读 .env——启动脚本用 node --env-file=.env 喂进去（见 start.sh）。

# ─── 数据库 ───────────────────────────────────────────────
# 5432 是原生 PostgreSQL 的端口。别用 54329——那只是 PC 上 Docker Compose
# 的宿主映射（compose.yaml:12），Termux 没有 Docker 也就没有这层映射。
# initdb 出来的库属主就是当前 Termux 用户，所以走 Unix socket 免密最省事；
# TCP 那行留着备用（改了 pg_hba.conf 想用密码时换过去）。
DATABASE_URL=postgresql:///sullyos?host=/data/data/com.termux/files/usr/var/run/postgresql
# DATABASE_URL=postgresql://sullyos:你的密码@127.0.0.1:5432/sullyos

# ─── 监听 ─────────────────────────────────────────────────
# 保持 127.0.0.1。这个后端只有一个静态 bearer token 挡着，也没有 TLS，
# 绑 0.0.0.0 等于把整个角色库暴露给同一 WiFi 下的所有设备。
HOST=127.0.0.1
# 43210 与前端「SullyOS 自主后端」面板的占位符一致，填地址时一字不用改。
PORT=43210

# ─── 密钥 <必填> ──────────────────────────────────────────
# 生成：openssl rand -hex 32   （Termux: pkg install openssl-tool）
# APP_TOKEN 是除 /health 和配对/查岗四个端点之外所有路由的唯一凭据。
APP_TOKEN=
# 单独生成，不要留空。留空会回落成 APP_TOKEN（config.ts:39），
# 那样以后轮换 APP_TOKEN 就再也解不开库里存的模型 API Key。
MODEL_VAULT_KEY=

# ─── 心跳用的模型 <必填，想让角色自主活动的话> ────────────
# OpenAI 兼容接口，不要带 /chat/completions 后缀。
# 把你在 SullyOS 前端里测通的那套直接抄过来。
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=

# ─── 备份落盘目录 ────────────────────────────────────────
# 必须是绝对路径：backupRoutes.ts:28 用 path.resolve，相对路径会跟着进程的
# 工作目录漂——服务化之后 cwd 和你手敲时不是一个地方。
BACKUP_DIR=/data/data/com.termux/files/home/sullyos-backup

# ─── CORS ────────────────────────────────────────────────
# 手机浏览器开 http://127.0.0.1:4173，origin 就是它。
# 默认值已含 4173/5173，这里显式写一遍免得以后改端口忘了同步。
ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:5173,http://localhost:5173

# ─── 心跳节奏 ────────────────────────────────────────────
# 默认 30 秒。手机上这是电量决定而不是正确性决定，调到 2 分钟以上。
# 轮询到点不等于每次都调 AI——角色自己的开关/时段/概率仍然生效。
HEARTBEAT_POLL_MS=120000

# ─── Web Push（可选）────────────────────────────────────
# 生成：cd backend && node node_modules/.bin/web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:you@example.com
